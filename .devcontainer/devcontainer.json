{
  "name": "Russell's BaseAgent",
  // The Python devcontainer image, minus its broken Yarn apt source (see Dockerfile).
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    // Docker for the code runner's sandboxes (and the planned Claude Code sandbox).
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy",
    "UV_PYTHON_PREFERENCE": "only-system",
    // Google sign-in for Colab T4 runs lives outside the repo and outside $HOME, so it
    // survives container rebuilds (Codespaces keeps /workspaces) and is never committed.
    "CLOUDSDK_CONFIG": "/workspaces/.gcloud"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"
  },
  // Codespaces passes repository/user secrets in as environment variables.
  // Add OPENAI_API_KEY at github.com/settings/codespaces (or the repo's
  // Settings > Secrets > Codespaces) and allow this repository to use it.
  "secrets": {
    "OPENAI_API_KEY": { "description": "Your OpenAI API key." },
    "OPENAI_MODEL": { "description": "Optional default model, e.g. gpt-5-mini." }
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Chat room", "onAutoForward": "openBrowser" },
    "8000": { "label": "Agent API", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Every start and resume: bring the chat room up in the background (make dev-log, make stop).
  "postStartCommand": "bash scripts/background.sh start --auto",
  "postAttachCommand": "echo 'The chat room starts by itself: open the Chat room port (5173). Logs: make dev-log. Run in this terminal instead: make dev.'",
  "customizations": {
    // Read access to the private skills repo, for the knowledge/ submodule. Applies only to
    // codespaces created after this is committed; GitHub asks you to authorize it then.
    "codespaces": {
      "repositories": {
        "xqzr2000/jack-knows-it-all": { "permissions": { "contents": "read" } }
      }
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "python.terminal.activateEnvironment": true
      }
    }
  }
}
